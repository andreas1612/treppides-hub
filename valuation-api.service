[Unit]
Description=Valuation Reference API — Treppides Hub backend
After=network.target

[Service]
Type=simple
User=tech-admin
WorkingDirectory=/home/tech-admin/treppides-hub/api/valuation
ExecStart=/home/tech-admin/treppides-hub/api/valuation/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8002
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
