# Real config with API credentials — never commit this
config.js

# ClickUp API credentials
api/clickup/.env
api/companies/.env

# Staff directory credentials
staff-directory/.env

# Company master database — rebuilt on the server from ClickUp via sync.py,
# not committed (like the valuation DB). WAL sidecar files too.
api/companies/companies.db
api/companies/companies.db-wal
api/companies/companies.db-shm

# Temp exploration / local test scripts (anything underscore-prefixed under api/)
api/*/_*.py

# Python bytecode and virtualenvs (global — catch every directory)
__pycache__/
*.pyc
venv/
.venv/

# Built reference database — rebuilt on the server via seed_database.py +
# backfill_damodaran.py + update_damodaran.py. Committing it caused diff
# noise and pull conflicts every refresh.
api/valuation/valuation_reference.db

# Local operational runbook — kept out of git because it contains exact
# server commands and is for the maintainer's reference, not the repo.
DATABASE_INSTRUCTIONS.md

# Local working-session notes (handoff scratchpad) — not for the repo.
LOCAL_SESSION.md

# Security review notes — contains live secrets + exploit detail; never commit.
SECURITY_CHECKUP.md

# Raw data files — PII, never commit
staff.xlsx
staff.json
media/images/
media/videos/

# Claude Code local settings (per-machine)
.claude/

# team-calendar secrets + transient sqlite files
api/team-calendar/.env
*.db-shm
*.db-wal

# Local TB Ratio test harnesses + sample/real trial-balance files — never commit
# (contains client data + throwaway standalone/diagnostic pages).
_test/
