# ============================================================
# Company Finder API — environment variables.
# Copy this file to .env and fill in real values.
# .env is in .gitignore and must NEVER be committed.
# ============================================================

# ClickUp personal API token (starts with "pk_") — same token the Fees API uses.
CLICKUP_API_TOKEN=pk_your_token_here

# The 10 CRM Space IDs to index, comma-separated, NO spaces.
# (Same value as in api/clickup/.env.)
CLICKUP_SPACE_IDS=space_id_1,space_id_2,space_id_3

# Workspace/Team ID — optional, auto-discovered from the token if blank.
# CLICKUP_TEAM_ID=your_team_id

# Deal statuses (lowercased) treated as Rejected/Lost — excluded from the
# headline "active" Deal Value total and shown separately. Comma-separated.
# Default: rejected,on hold - stall
# COMPANIES_LOST_STATUSES=rejected,on hold - stall
