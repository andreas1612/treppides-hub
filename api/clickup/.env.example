# ============================================================
# ClickUp Fees Aggregator — environment variables.
# Copy this file to .env and fill in real values.
# .env is in .gitignore and must NEVER be committed.
# ============================================================

# ClickUp personal API token (starts with "pk_")
# Generate at: https://app.clickup.com/settings/apps → API Token
CLICKUP_API_TOKEN=pk_your_token_here

# ClickUp List IDs — find in list URL: https://app.clickup.com/{workspace}/{list_id}/...
# All three lists feed the AML Dashboard.
CLICKUP_LIST_NEW=your_new_clients_list_id
CLICKUP_LIST_REJECTED=your_rejected_clients_list_id
CLICKUP_LIST_DISENGAGED=your_disengaged_clients_list_id

# Legacy single-list var — used as fallback for CLICKUP_LIST_NEW if that
# is not set. Safe to remove once CLICKUP_LIST_NEW is populated.
# CLICKUP_LIST_ID=your_list_id_here

# Forms tool — each Hub form creates a task in its own ClickUp List.
# The Forms tool (Tools section) submits Lead/Deal forms to these lists.
CLICKUP_FORM_LEAD_LIST=your_leads_list_id
CLICKUP_FORM_DEAL_LIST=your_deals_list_id

# NOTE: The cross-space Company Finder moved to its own service. Its config
# (CLICKUP_SPACE_IDS etc.) now lives in api/companies/.env — see
# api/companies/.env.example.
