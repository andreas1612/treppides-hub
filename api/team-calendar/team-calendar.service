[Unit]
Description=Team Calendar API
After=network.target

[Service]
Type=simple
User=tech-admin
WorkingDirectory=/home/tech-admin/treppides-hub/api/team-calendar
EnvironmentFile=/home/tech-admin/treppides-hub/api/team-calendar/.env
ExecStart=/home/tech-admin/treppides-hub/api/team-calendar/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8004
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
